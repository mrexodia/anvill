  COMMAND = cd /work/anvill/build21/libraries/version && /usr/bin/cmake -DCMAKE_INSTALL_DO_STRIP=1 -P cmake_install.cmake
  DESC = Installing the project stripped...
  pool = console
  restat = 1

build libraries/version/install/strip: phony libraries/version/CMakeFiles/install/strip.util

