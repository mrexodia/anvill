@PACKAGE_INIT@

cmake_minimum_required(VERSION 3.21)

if(NOT TARGET anvill)

  include(CMakeFindDependencyMacro)
  find_dependency(remill)

  # anvill publicly links z3::libz3. Prefer Z3's CMake package and fall back
  # to a plain library lookup (e.g. Ubuntu's libz3-dev has no CMake package).
  if(NOT TARGET z3::libz3)
    find_package(Z3 CONFIG QUIET)
    if(NOT TARGET z3::libz3)
      find_path(Z3_INCLUDE_DIR z3++.h REQUIRED)
      find_library(Z3_LIBRARY z3 REQUIRED)
      add_library(z3::libz3 UNKNOWN IMPORTED)
      set_target_properties(z3::libz3 PROPERTIES
        IMPORTED_LOCATION "${Z3_LIBRARY}"
        INTERFACE_INCLUDE_DIRECTORIES "${Z3_INCLUDE_DIR}"
      )
    endif()
  endif()

  # The static anvill library links protobuf::libprotobuf.
  if(NOT TARGET protobuf::libprotobuf)
    find_package(Protobuf CONFIG QUIET)
    if(NOT TARGET protobuf::libprotobuf)
      find_dependency(Protobuf MODULE)
    endif()
  endif()

  # Exported Targets
  include("${CMAKE_CURRENT_LIST_DIR}/anvillTargets.cmake")

endif()
