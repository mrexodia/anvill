# An `others { stop: true }` override on a normal instruction stops lifting
# after that instruction: the block ends with `__remill_error` and the
# following instructions are not lifted.
#   401000: b8 01 00 00 00 movl $0x1, %eax
#   401005: b8 02 00 00 00 movl $0x2, %eax
#   40100a: c3 retq
# RUN: --add_names
arch: ARCH_AMD64
operating_system: OS_LINUX
functions {
  entry_address: 0x401000
  callable {
    return_address { mem { base_reg: "RSP" offset: 0 } }
    return_stack_pointer { reg { register_name: "RSP" } offset: 8 }
    return { values { reg { register_name: "EAX" } } type { base: BT_I32 } }
  }
}
memory_ranges { address: 0x401000 is_executable: true values: "\xb8\x01\x00\x00\x00\xb8\x02\x00\x00\x00\xc3" }
overrides { others { address: 0x401005 stop: true } }
symbols { name: "stops" address: 0x401000 }
