# `ud2` is an error instruction: its path ends with `__remill_error`, which
# RemoveErrorIntrinsics turns into `unreachable`, so the optimizer can assume
# that path is never taken.
#   401000: 85 ff testl %edi, %edi
#   401002: 75 02 jne 0x401006 <.text+0x6>
#   401004: 0f 0b ud2
#   401006: 89 f8 movl %edi, %eax
#   401008: c3 retq
# RUN: --add_names
arch: ARCH_AMD64
operating_system: OS_LINUX
functions {
  entry_address: 0x401000
  callable {
    return_address { mem { base_reg: "RSP" offset: 0 } }
    return_stack_pointer { reg { register_name: "RSP" } offset: 8 }
    parameters { name: "x" repr_var { values { reg { register_name: "EDI" } } type { base: BT_I32 } } }
    return { values { reg { register_name: "EAX" } } type { base: BT_I32 } }
  }
}
memory_ranges { address: 0x401000 is_executable: true values: "\x85\xff\x75\x02\x0f\x0b\x89\xf8\xc3" }
symbols { name: "checked" address: 0x401000 }
