# A direct jump marked as a call by a Call override is a tail call: the
# callee is called with the current state and the block ends with
# `__remill_error` (control never falls out of a tail call).
#   int g(int);
#   int f(int a) { return g(a + 1); }
#   401000: 83 c7 01 addl $0x1, %edi
#   401003: e9 f8 0f 00 00 jmp 0x402000 <.text+0x1000>
# RUN: --add_names
arch: ARCH_AMD64
operating_system: OS_LINUX
functions {
  entry_address: 0x401000
  callable {
    return_address { mem { base_reg: "RSP" offset: 0 } }
    return_stack_pointer { reg { register_name: "RSP" } offset: 8 }
    parameters { name: "a" repr_var { values { reg { register_name: "EDI" } } type { base: BT_I32 } } }
    return { values { reg { register_name: "EAX" } } type { base: BT_I32 } }
  }
}
functions {
  entry_address: 0x402000
  func_linkage: FUNCTION_LINKAGE_EXTERNAL
  callable {
    return_address { mem { base_reg: "RSP" offset: 0 } }
    return_stack_pointer { reg { register_name: "RSP" } offset: 8 }
    parameters { name: "a" repr_var { values { reg { register_name: "EDI" } } type { base: BT_I32 } } }
    return { values { reg { register_name: "EAX" } } type { base: BT_I32 } }
  }
}
memory_ranges { address: 0x401000 is_executable: true values: "\x83\xc7\x01\xe9\xf8\x0f\x00\x00" }
overrides { calls { address: 0x401003 is_tailcall: true } }
symbols { name: "f" address: 0x401000 }
symbols { name: "g" address: 0x402000 }
