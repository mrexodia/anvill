# SPARC V9 conditional branch with a delay slot that is not annulled: the
# `mov 20` in the delay slot executes on both paths, so the result is 20 when
# x == 0 and 10 otherwise. Sleigh decodes the branch and its delay slot as
# one instruction whose fall-through is 0x401008.
#   long pick(long x) { return x == 0 ? 20 : 10; }
#   401000: 02 c2 00 03 brz,pn %o0, 0x40100c
#   401004: 92 10 20 14 mov 20, %o1
#   401008: 92 10 20 0a mov 10, %o1
#   40100c: 81 c3 e0 08 retl
#   401010: 90 10 00 09 mov %o1, %o0
# RUN: --add_names
arch: ARCH_SPARC64
operating_system: OS_LINUX
functions {
  entry_address: 0x401000
  callable {
    type { function { return_type { base: BT_I64 } arguments { base: BT_I64 } } }
  }
}
memory_ranges { address: 0x401000 is_executable: true values: "\x02\xc2\x00\x03\x92\x10\x20\x14\x92\x10\x20\x0a\x81\xc3\xe0\x08\x90\x10\x00\x09" }
symbols { name: "pick" address: 0x401000 }
