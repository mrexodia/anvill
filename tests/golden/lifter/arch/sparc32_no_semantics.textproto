# SPARC32 leaf function whose addition is in the delay slot of `retl`.
# The allocator places the arguments in O0 and O1 and the result in O0, with
# the return address in O7, and the delay slot is bracketed by
# __remill_delay_slot_begin/end.
#
# LIMITATION (upstream remill): the remill version used here has no
# semantics for these SPARC32 instructions: each one is lifted as a
# `__remill_sync_hyper_call(..., 1024)` (kSPARC32EmulateInstruction), as
# `remill-lift-19 --arch sparc32 --bytes 81c3e00890020009` shows too. The
# `add` therefore has no effect and the optimized function returns its first
# argument; the whole State stays live because it escapes into the hyper
# calls. This case pins the ABI and delay-slot plumbing, not the semantics.
# (Hand-encoded; ld.lld cannot link 32-bit SPARC.)
#   int add(int a, int b) { return a + b; }
#   401000: 81c3e008 retl
#   401004: 90020009 add %o0, %o1, %o0
# RUN: --add_names
arch: ARCH_SPARC32
operating_system: OS_LINUX
functions {
  entry_address: 0x401000
  callable {
    type {
      function {
        return_type { base: BT_I32 }
        arguments { base: BT_I32 }
        arguments { base: BT_I32 }
      }
    }
  }
}
memory_ranges { address: 0x401000 is_executable: true values: "\x81\xc3\xe0\x08\x90\x02\x00\x09" }
overrides { returns { address: 0x401000 } }
symbols { name: "add" address: 0x401000 }
